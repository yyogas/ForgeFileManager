# Use these as environment variables in PHP-FPM / the web server process.
# Never commit real values or expose the storage root through the web root.
FFM_USERNAME=hosting_user
FFM_PASSWORD_HASH=REPLACE_WITH_OUTPUT_OF_bin/hash-password.php
FFM_STORAGE_ROOT=/srv/hosting/example-user
FFM_EDITOR_MAX_BYTES=1048576
FFM_MAX_ENTRIES=2000
FFM_UPLOAD_MAX_BYTES=104857600
FFM_ALLOW_WORLD_WRITABLE=0
# Development only; HTTP must not be enabled in production.
FFM_ALLOW_HTTP_DEV=0

# Development testing only if running tests inside a root-owned container.
FFM_ALLOW_ROOT_DEV=0

# Recycle bin is optional; production deletes are blocked if absent.
# Must exist and be owner-only (chmod 700), same filesystem as FFM_STORAGE_ROOT,
# and outside hosting, web and application directories.
# FFM_TRASH_ROOT=/srv/forge-private/hosting_user-trash

# The old virtual demo is REMOVED. FFM_DEMO_MODE=1 is rejected.
FFM_DEMO_MODE=0

# Known demo/demo123 credentials are only for an explicit localhost sandbox.
# Never enable it on a public server or combine with live account settings.
FFM_TEST_SANDBOX=0
# FFM_TEST_STORAGE_ROOT=/tmp/ffm-private-test
# FFM_TEST_TRASH_ROOT=/tmp/ffm-private-trash

# Directory listing cap: explicit error instead of hidden truncation.
FFM_LIST_SCAN_LIMIT=50000
